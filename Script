-- Loop que remove qualquer lentidão, travamento ou paralisia da teia continuamente
task.spawn(function()
    while true do
        task.wait(0.2)
        if antiTeiaAtivo then
            pcall(function()
                local char = localPlayer.Character
                if char then
                    local humanoid = char:FindFirstChildOfClass("Humanoid")
                    if humanoid then
                        -- Força a velocidade normal caso a teia tente abaixar
                        if humanoid.WalkSpeed < 16 then
                            humanoid.WalkSpeed = 16
                        end
                    end
                    -- Remove efeitos e pastas de slow/stun aplicadas pelo mapa ou pela aranha
                    for _, child in ipairs(char:GetChildren()) do
                        if child:IsA("Folder") or child:IsA("StringValue") or child:IsA("BoolValue") then
                            local nome = child.Name:lower()
                            if nome:find("stun") or nome:find("slow") or nome:find("web") or nome:find("teia") or nome:find("paralis") then
                                child:Destroy()
                            end
                        end
                    end
                end
            end)
        end
    end
end)

-- Lógica para acionar ClickDetector / Mãozinha
local function dispararCliqueItem(item)
    local cd = item:FindFirstChildWhichIsA("ClickDetector", true)
    if not cd and item.Parent then
        cd = item.Parent:FindFirstChildWhichIsA("ClickDetector", true)
    end
    if cd and fireclickdetector then
        fireclickdetector(cd)
    end

    local pGui = localPlayer:FindFirstChild("PlayerGui")
    if pGui then
        for _, gui in ipairs(pGui:GetChildren()) do
            if gui:IsA("ScreenGui") and gui.Enabled then
                for _, btn in ipairs(gui:GetDescendants()) do
                    if btn:IsA("ImageButton") or btn:IsA("TextButton") then
                        if btn.Name:lower():find("touch") or btn.Name:lower():find("hand") or btn.Name:lower():find("interact") or btn.Name:lower():find("grab") then
                            pcall(function() firesignal(btn.MouseButton1Click); firesignal(btn.Activated) end)
                        end
                    end
                end
            end
        end
    end
end

-- Função para Pegar Item
local function pegarItemSpider(nomeItem)
    local char = localPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    local hrp = char.HumanoidRootPart
    local posicaoOriginal = hrp.CFrame

    local itemAlvo = nil
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name:lower():find(nomeItem:lower():gsub("%s+", "")) or obj.Name:lower():find(nomeItem:lower()) then
            if obj:IsA("Tool") or obj:IsA("Model") or obj:IsA("BasePart") then
                itemAlvo = obj
                break
            end
        end
    end

    if itemAlvo then
        local posItem = itemAlvo:IsA("BasePart") and itemAlvo.CFrame or (itemAlvo:FindFirstChildWhichIsA("BasePart") and itemAlvo:FindFirstChildWhichIsA("BasePart").CFrame)
        if posItem then
            hrp.CFrame = posItem + Vector3.new(0, 0.5, 0)
            task.wait(0.2)
            dispararCliqueItem(itemAlvo)
            
            local prompt = itemAlvo:FindFirstChildWhichIsA("ProximityPrompt", true) or (itemAlvo.Parent and itemAlvo.Parent:FindFirstChildWhichIsA("ProximityPrompt", true))
            if prompt and fireproximityprompt then
                fireproximityprompt(prompt)
            end

            task.wait(0.3)
            hrp.CFrame = posicaoOriginal
        end
    end
end

