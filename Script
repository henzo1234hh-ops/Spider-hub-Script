-- Lista de Jogadores
local function atualizarListaJogadores()
    for _, child in ipairs(scrollPlayers:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local lista = Players:GetPlayers()
    scrollPlayers.CanvasSize = UDim2.new(0, 0, 0, (#lista - 1) * 35)

    for _, p in ipairs(lista) do
        if p ~= localPlayer then
            local pBtn = Instance.new("TextButton")
            pBtn.Size = UDim2.new(1, -10, 0, 30)
            pBtn.BackgroundColor3 = Color3.fromRGB(60, 30, 30)
            pBtn.Text = p.DisplayName .. " (@" .. p.Name .. ")"
            pBtn.TextColor3 = Color3.fromRGB(255, 220, 220)
            pBtn.Font = Enum.Font.SourceSansBold
            pBtn.TextSize = 12
            pBtn.Parent = scrollPlayers

            local pCorner = Instance.new("UICorner")
            pCorner.CornerRadius = UDim.new(0, 5)
            pCorner.Parent = pBtn

            pBtn.MouseButton1Click:Connect(function()
                local myChar = localPlayer.Character
                local targetChar = p.Character
                if myChar and targetChar and myChar:FindFirstChild("HumanoidRootPart") and targetChar:FindFirstChild("HumanoidRootPart") then
                    myChar.HumanoidRootPart.CFrame = targetChar.HumanoidRootPart.CFrame + Vector3.new(0, 2, 0)
                end
            end)
        end
    end
end

Players.PlayerAdded:Connect(atualizarListaJogadores)
